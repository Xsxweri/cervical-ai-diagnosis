# 项目特定：深度学习模型权重（大文件）
# 说明：模型权重通常几百MB~数GB，建议用 Git LFS 管理或单独备份
# 模型权重文件
*.pth
*.pt
*.ckpt
*.h5
*.pb
*.onnx
*.torchscript
*.engine          # TensorRT
*.tflite          # TensorFlow Lite
*.mlmodel         # CoreML
*.pkl             # Pickle 模型

# 训练中间文件（不保留）
outputs/models/latest_*
outputs/models/epoch_*
outputs/models/checkpoint_*
runs/*/weights/last.pt
runs/*/weights/epoch_*.pt

# 保留最佳模型（如需用LFS管理，请取消下面注释）
# !outputs/models/best_*.pth
# !outputs/models/best_*.pt
# !runs/*/weights/best.pt

# 项目特定：YOLO/Ultralytics 训练输出
runs/detect/
runs/segment/
runs/classify/
runs/pose/
!runs/.gitkeep

# YOLO 缓存
*.cache
**/*.cache
labels.cache
train.cache
val.cache
test.cache

# 项目特定：数据集（原始数据不放Git）
# 说明：HERLEV + SIPaKMeD 约6GB，需单独下载
data/
!data/.gitkeep

# 数据集压缩包
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# 项目特定：Web应用上传文件
# 说明：患者医学图像，涉及隐私，绝不进Git
uploads/
!uploads/.gitkeep

# 项目特定：评估与推理输出
outputs/
!outputs/.gitkeep

# 评估结果文件
**/detection_evaluation.json
**/classification_report.json
**/uncertainty_data.json
**/cross_validation_results.txt
**/summary_report.txt

# 可视化输出
**/confusion_matrix.png
**/confusion_matrix.npy
**/roc_curves.png
**/training_curves_*.png
**/prediction_result.png
**/visualizations/
**/grad_cam_*.png

# TensorBoard 日志
outputs/logs/
runs/*/events.out.tfevents.*

# 项目特定：WandB 实验跟踪
wandb/

# 项目特定：多中心评估临时文件
**/multicenter_evaluation.json


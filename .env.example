OPENAI_API_KEY=your_api_key_here
LLM_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
YOLO_WEIGHTS=runs/detect/cervical_cell_exp4/weights/best.pt
BINARY_WEIGHTS=outputs/models/best_resnet50_binary_model.pth
MULTI_WEIGHTS=outputs/models/best_resnet50_multiclass_sipakmed_model.pth
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change_me_to_a_long_random_hex_string
# 不确定性分级阈值（作用于「归一化熵」∈[0,1]）：>HIGH→追问澄清；(MEDIUM,HIGH]→深度检索；<=MEDIUM→直接报告
# 标定：SIPaKMeD 60 张单细胞图 / P90 聚合 / 目标追问率 10%（±1 样本）
# 临时值，须在真实多细胞视野 + 多分类重训后重新标定
UNCERTAINTY_HIGH=0.60
UNCERTAINTY_MEDIUM=0.30
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=false

# ===== RAG 检索 =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=            # 留空则按 VISION_DEVICE 或 cuda/cpu 自动选择
EMBEDDING_LOCAL_ONLY=true   # 只用本地模型缓存，不联网检查更新（内网/离线必开）

# RAG 配置文件路径
RAG_TERMS_FILE=configs/rag_terms.yaml             # 术语白名单 + alias + 意图规则
RAG_CORPUS_MANIFEST=configs/corpus_manifest.yaml  # 语料 doc_type 权威性标注

# 首次部署需下载模型时设为 false
# HuggingFace 离线模式：避免每次实例化嵌入模型都向 huggingface.co 发 HEAD 请求
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

RAG_HYBRID=true              # 向量 + BM25 混合；false 退化为纯向量
RAG_MERGE_SAME_PAGE=true     # 合并同 source+page 的 chunk（MinerU 按 section 切分会拆散表格）
RAG_RRF_K=60                 # RRF 平滑常数
RAG_CANDIDATE_POOL=40        # 融合前候选池（实际取 max(此值, 3k)）
RAG_MMR=false                # 最大边际相关性去冗余
RAG_MMR_LAMBDA=0.7           # 0=纯多样性，1=纯相关性
RAG_QUERY_CACHE=256          # 查询结果 LRU 容量
RAG_INDEX_LOCK_TIMEOUT=300   # 跨进程索引锁等待上限（秒）
RAG_NL_VARIANT_WEIGHT=0.5    # 派生查询变体在 RRF 中的权重
RAG_DOC_WEIGHT=true          # 按 doc_type 给权威性加成（I 级指南优先）

# ===== 查询改写（NL 入口）=====
RAG_NL_MAX_VARIANTS=3        # 多查询变体上限
RAG_LLM_REWRITE=false        # L3：LLM 兜底改写，默认关
RAG_REWRITE_TIMEOUT=8        # LLM 改写超时（秒）

# ===== 证据充分性 =====
EVIDENCE_RELEVANT_COS=0.50   # 视为"相关文献"的余弦下界
EVIDENCE_FULL_COUNT=3        # 充分性达到 1.0 所需的相关文献条数